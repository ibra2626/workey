# workey configuration — copy to .env and fill in. Never commit .env.
# Values here are placeholders only.

# Listen address. Default: 127.0.0.1:8080
WORKEY_ADDR=127.0.0.1:8080

# Path to the SQLite database file (used from WKY-02 onward).
WORKEY_DB_PATH=workey.db

# Bearer token for the REST API and MCP endpoint.
WORKEY_API_TOKEN=change-me

# bcrypt hash of the single-user web password (generate with: workey hash-password).
WORKEY_PASSWORD_HASH=change-me

# Random key (>= 32 bytes) used to sign session cookies.
WORKEY_SESSION_KEY=change-me

# Target exam date (YYYY-MM-DD). Default: 2027-07-18
WORKEY_EXAM_DATE=2027-07-18

# Set Secure flag on cookies (true in production over HTTPS). Default: true
WORKEY_COOKIE_SECURE=true

# Set to 1 to allow starting without token/hash/session key (local development only).
# WORKEY_DEV=1
