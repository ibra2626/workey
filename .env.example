# Copy to .env and replace the placeholders. Never commit .env.
# Workey loads .env from the working directory; process environment takes priority.
# Values are literal: password hashes containing $ do not need escaping.

WORKEY_ADDR=127.0.0.1:8080
WORKEY_DB_PATH=workey.db

# Bearer token for REST/MCP. Replace with a random token.
WORKEY_API_TOKEN=change-me

# PBKDF2-SHA256 hash, generated with: go run ./cmd/workey hash-password
# This is a hash field, not the plain-text login password.
WORKEY_PASSWORD_HASH=change-me

# Random key (>=32 bytes) for signed session cookies.
WORKEY_SESSION_KEY=change-me

WORKEY_EXAM_DATE=2027-07-18

# Local HTTP: false. Use true when serving over HTTPS.
WORKEY_COOKIE_SECURE=false

# Optional local development without a password: set 1 AND leave the hash empty.
# WORKEY_DEV=1
# WORKEY_PASSWORD_HASH=
