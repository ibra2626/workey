package views

// Placeholder proves the base layout before the real screens land (WKY-03+).
// It renders a single flat panel with a heading and a sample-data note; the
// Turkish glyphs here exercise both font subsets at render time.
templ Placeholder(active string, title string, heading string, csrf string) {
	@Layout(title, active, csrf) {
		<div class="mx-auto max-w-[760px]">
			<section class="rounded-panel bg-card p-5 md:p-7">
				<p class="text-label text-ink-3">Taslak düzen · WKY-02</p>
				<h1 class="mt-1 text-headline font-bold leading-tight md:text-headline-display">{ heading }</h1>
				<p class="mt-3 text-body text-ink-2">
					Çatı düzeni hazır: şğıİçöü karakterleri Barlow ile düzgün görünmeli.
					Rakamlar dar kesimde: <span class="cn text-numeral-inline-lg text-ink">263 gün</span>,
					<span class="cn text-numeral-inline text-ink">%13</span>, <span class="cn text-numeral-inline text-ink">8,5 net</span>.
				</p>
				<p class="mt-2 text-body-small text-ink-3">Gerçek plan asistan tarafından API ile yazılacak; buradaki sayılar örnek veridir.</p>
			</section>
		</div>
	}
}
