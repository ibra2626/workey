package views

import (
	"strconv"

	"github.com/ibra2626/workey/internal/plan"
)

// Today is the Bugün screen: tonight's assignment in the first panel with a
// one-tap "Tamamlandı", the week/exam stat tiles and the generated note on
// mobile, and a two-column grid with the phase panel on desktop. It matches the
// Bugün artboards of design/directions/04-antrenman-gunlugu.html.
templ Today(p TodayPage) {
	@Layout(LayoutProps{Title: "Workey · Bugün", Active: "bugun", CSRF: p.CSRF, DaysToExam: p.DaysToExam, HasExam: p.HasExam}) {
		@TodayMain(p)
	}
}

// TodayMain swaps the session together with all dependent summary figures.
templ TodayMain(p TodayPage) {
	<div id="bugun-main">
		if p.StudyFeedback != "" {
			<div id="study-feedback" class="study-feedback mb-3 rounded-panel bg-card p-5 text-body text-ink" role={ studyFeedbackRole(p.StudyInvalid) } tabindex="-1">
				<p>{ p.StudyFeedback } <a class="study-link" href="/">Güncel durumu yenile</a></p>
				if p.StudyInput != nil {
					<p class="mt-2 text-body-small text-ink-2">Gönderilen kaynak: { p.StudyInput.Ordinal }; aşama: { p.StudyInput.Stage }; devam sayfası: { p.StudyInput.Page }. Bu giriş kaydedilmedi.</p>
				}
			</div>
		}
		<div class="flex items-baseline justify-between px-1">
			<p class="text-title-lg font-semibold text-ink md:text-headline md:font-bold">{ p.Day.Heading }</p>
			<p class="text-meta text-ink-3 tnum md:text-body-small">
				<span class="md:hidden">
					if p.WeekNumber > 0 {
						Hafta { strconv.Itoa(p.WeekNumber) }
					}
				</span>
				<span class="hidden md:inline">
					if p.WeekNumber > 0 {
						Hafta { strconv.Itoa(p.WeekNumber) } / 38
					}
				</span>
			</p>
		</div>
		<div class="mt-5 grid gap-3 md:gap-5 xl:grid-cols-[1fr_340px]">
			<div class="min-w-0 space-y-3 md:space-y-5">
				@TodayPanel(p)
				if p.Day.ActiveStudy != nil {
					<section id="today-plan" class="rounded-panel bg-card p-5 md:p-8">
						<h2 class="text-title-lg font-semibold">Bugünün planı</h2>
						if p.Day.IsRest {
							<p class="mt-2 text-body">Bugün dinlenme.</p>
						} else {
							for _, sv := range p.Day.Sessions {
								<p class="mt-3 text-body">{ sv.Notation } · { chapterTitle(sv) }</p>
								if sv.ID != p.Day.ActiveStudy.ID {
									<p class="text-body-small text-ink-2">Başka bir seansa geçmek için önce <a class="study-link" href="#bugun-panel">açık çalışmayı kapat</a>.</p>
									@studyFinish(sv, p.CSRF)
								}
							}
						}
					</section>
				}
				if p.Day.LatestPausedStudy != nil && (!p.HasPlan || p.AfterExam || p.Day.IsRest || p.Day.LatestPausedStudy.Date != p.Day.Date || p.Day.ActiveStudy != nil || firstSession(p.Day).ID != p.Day.LatestPausedStudy.ID) {
					<section class="rounded-panel bg-card p-5 md:p-8">
						<h2 class="text-title-lg font-semibold">Kaldığın yer</h2>
						@studyWorkspace(*p.Day.LatestPausedStudy, p)
					</section>
				}
			</div>
			<!-- Mobile: stat tiles and the generated note. -->
			<div class="md:hidden">
				<div class="grid grid-cols-3 gap-3">
					@statTile("Sınava", examFigure(p), "gün")
					@statTileFrac("Bu hafta", p.WeekDoneMin, p.WeekPlannedMin, "dakika")
					@statTileFrac("Seans", p.SessionsDone, p.SessionsPlan, "seans")
				</div>
				<p class="mt-3 text-meta text-ink-3">{ progressMeasure }</p>
				if len(p.Day.Notes) > 0 {
					<p class="mt-4 text-meta text-ink-3">{ p.Day.Notes[0] }</p>
				}
			</div>
			<!-- Desktop: side column of small panels. -->
			<div class="hidden md:flex md:flex-col md:gap-5">
				@todayWeekMini(p)
				@todayTomorrow(p.Day.Tomorrow)
				@todayNote(p.Day.Notes)
			</div>
			<!-- Desktop: full-width current-phase panel. -->
			if len(p.PhaseBlocks) > 0 {
				<section class="hidden rounded-panel bg-card p-6 md:block xl:col-span-2">
					<div class="flex items-baseline justify-between">
						<p class="text-label font-semibold text-ink-3">{ p.PhaseLabel }</p>
					</div>
					<div class="mt-4 grid grid-cols-7 gap-3">
						for _, b := range p.PhaseBlocks {
							<div>
								<div class="chart-rise relative h-[44px] overflow-hidden rounded-block bg-z1-soft">
									if b.FillPct > 0 {
										<span class="absolute inset-y-0 left-0 bg-ink" { styleAttr("width:" + pct(b.FillPct))... }></span>
									}
								</div>
								<p class={ "mt-1.5 text-meta tnum", templ.KV("font-semibold text-ink", b.IsCurrent), templ.KV("text-ink-2", !b.IsCurrent) }>{ b.Label }</p>
								if b.Sub != "" {
									<p class="text-label tnum text-ink-3">{ b.Sub }</p>
								}
							</div>
						}
					</div>
				</section>
			}
		</div>
	</div>
}

// TodayPanel is the first panel inside the swappable TodayMain content.
// It holds tonight's session and its "Tamamlandı"
// action, or an empty / rest / after-exam state. The First Panel Rule: at
// 390×844 everything fits without scrolling.
templ TodayPanel(p TodayPage) {
	if p.Day.ActiveStudy != nil {
		{{ sv := *p.Day.ActiveStudy }}
		<section
			id="bugun-panel"
			class="room rounded-panel p-5 md:p-8"
			data-room
			data-started={ sv.Study.LastStartedAt }
			data-offset={ strconv.Itoa(roomOffset(sv)) }
			data-segments={ roomSegmentsJSON(sv) }
		>
			@studyRoom(sv, p)
		</section>
	} else {
		@todayPlanPanel(p)
	}
}

templ todayPlanPanel(p TodayPage) {
	<section id="bugun-panel" class="rounded-panel bg-card p-5 md:p-8">
		switch  {
			case !p.HasPlan:
				<h1 class="text-title-lg font-semibold text-ink">Plan henüz yazılmadı.</h1>
				<p class="mt-2 text-body text-ink-2">Asistan planı yazınca bu akşamki seans burada görünecek.</p>
			case p.AfterExam:
				<h1 class="text-title-lg font-semibold text-ink">Sınav tamamlandı.</h1>
				<p class="mt-2 text-body text-ink-2">Plan dönemi bitti. Yeni bir dönem için asistan yeni bir plan yazabilir.</p>
			case p.Day.IsRest:
				<h1 class="text-title-lg font-semibold text-ink">Bugün dinlenme.</h1>
				<p class="mt-2 text-body text-ink-2">Bu akşam planlı seans yok. Yarın { tomorrowHint(p.Day.Tomorrow) }</p>
			default:
				if sv := firstSession(p.Day); sv.Study != nil && sv.State != plan.StateDone {
					<h1 class="text-headline font-bold leading-tight">{ studyTitle(sv) }</h1>
					<p class="mt-1 text-body text-ink-2">{ studyTopic(sv) }</p>
					@studyWorkspace(sv, p)
				} else {
					@todaySession(firstSession(p.Day), p)
				}
		}
	</section>
}

// todaySession renders tonight's assignment: book reference, chapter title, page
// range, the interval profile with its legend/detail, and the pill (or the done
// state with a quiet "Geri al" link).
templ todaySession(sv plan.SessionView, p TodayPage) {
	<p class="cn text-numeral-inline font-semibold text-ink-2 md:text-numeral-inline-lg">
		{ chapterRef(sv) }<span class="hidden md:inline">· { chapterBook(sv) }</span>
	</p>
	<div class="flex items-baseline justify-between gap-4">
		<h1 class="text-headline font-bold leading-tight md:text-headline-display">{ chapterTitle(sv) }</h1>
		<p class="hidden shrink-0 cn text-numeral-page font-semibold text-ink md:block">{ headPages(sv) }</p>
	</div>
	<p class="mt-1 text-body text-ink-2 md:hidden">
		{ chapterBook(sv) } · <span class="tnum font-semibold text-ink">{ headPages(sv) }</span>
	</p>
	if sv.TopicGroupName != "" {
		<p class="mt-1 text-body text-ink-2">Konu: { sv.TopicGroupName }</p>
	}
	if sv.State != plan.StateDone {
		<p class="mt-3 text-body text-ink-2">{ studyFirstStep(sv) }</p>
		@studyStart(sv, p)
		@studyFinish(sv, p.CSRF)
	}
	if len(sv.Items) > 1 {
		<ul class="mt-3 divide-y divide-line text-body-small text-ink-2" aria-label="Seans kaynakları">
			for _, item := range sv.Items {
				<li class="py-1.5">{ plan.FormatItem(item) } · { item.ChapterTitle }</li>
			}
		</ul>
	}
	<!-- Session interval profile. -->
	<div class="mt-6">
		<div class="flex h-[92px] items-end gap-1 md:h-[150px]">
			for _, b := range sessionProfile(sv) {
				<div
					class="relative flex items-start overflow-hidden rounded-bar md:rounded-block"
					{ styleAttr("flex:" + strconv.Itoa(b.Flex) + ";height:" + pct(b.HeightPct))... }
				>
					<span class="chart-rise absolute inset-0" { styleAttr("background:" + b.Fill)... } aria-hidden="true"></span>
					<div class="relative hidden p-2.5 md:block">
						<p class="text-title font-semibold leading-none text-ink">{ b.Label }</p>
						<p class="mt-1 cn text-numeral-profile font-semibold text-ink">{ b.Duration }</p>
					</div>
				</div>
			}
		</div>
		<div class="mt-1.5 flex justify-between text-label tnum text-ink-3">
			for _, t := range axisTicks(sv.StartTime, sv.DurationMin, sv.Kind != plan.KindAksam) {
				<span>{ t }</span>
			}
		</div>
	</div>
	<!-- Mobile: three-row legend. -->
	<dl class="mt-5 grid grid-cols-[auto_1fr_auto] items-baseline gap-x-3 gap-y-2.5 md:hidden">
		for _, b := range sessionProfile(sv) {
			<span class="h-2.5 w-2.5 rounded-xs" { styleAttr("background:" + b.Fill)... }></span>
			<dt class="text-body font-semibold text-ink">
				{ b.Label }
				if b.Pages != "" {
					<span class="font-normal text-ink-2">· { b.Pages }</span>
				}
			</dt>
			<dd class="cn text-numeral-inline font-semibold text-ink">{ b.Duration }</dd>
		}
	</dl>
	<!-- Desktop: parts detail. -->
	<div class="mt-6 hidden grid-cols-3 gap-6 text-body md:grid">
		for _, b := range sessionProfile(sv) {
			<p>
				<span class="font-semibold">{ b.Label }</span>
				if b.Pages != "" {
					<span>: { b.Pages }</span>
				}
			</p>
		}
	</div>
	if sv.State == plan.StateDone {
		@completeControl(sv, p.CSRF)
	}
}

// completeControl is the single primary action. When the session is done it
// becomes the done state with a quiet "Geri al" link; both post through htmx
// (swapping TodayMain) and fall back to a normal form POST + redirect with a
// hidden CSRF field for the no-JS path.
templ completeControl(sv plan.SessionView, csrf string) {
	if sv.State == plan.StateDone {
		<div class="completion-status mt-6 flex items-center justify-between md:mt-8" role="status">
			<p class="flex items-center gap-2 text-title-lg font-semibold text-ink">
				<svg class="completion-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" pathLength="1"></path></svg>
				Tamamlandı
			</p>
			<form method="post" { completeForm(sv.ID, "geri-al")... }>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<input type="hidden" name="expected_study_version" value={ strconv.FormatInt(sv.StudyVersion, 10) }/>
				<button id={ "today-action-" + strconv.FormatInt(sv.ID, 10) } type="submit" class="action-button secondary-action rounded-nav text-body-small text-ink-3 underline-offset-2 hover:text-ink hover:underline focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:2px]">@actionLabel("Geri al", "Geri alınıyor…")</button>
			</form>
		</div>
	} else {
		<form method="post" class="mt-6 md:mt-8" { completeForm(sv.ID, "tamamla")... }>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<input type="hidden" name="expected_study_version" value={ strconv.FormatInt(sv.StudyVersion, 10) }/>
			<button
				id={ "today-action-" + strconv.FormatInt(sv.ID, 10) }
				type="submit"
				class="action-button primary-action flex h-[54px] w-full items-center justify-center gap-2 rounded-pill bg-ink text-title-lg font-semibold text-card hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:3px] md:h-[56px] md:w-auto md:px-10"
			>
				<span class="action-label flex items-center gap-2"><svg class="action-check" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect><path d="m7.5 12 3 3 6-6"></path></svg>Seansı tamamla</span>
				<span class="action-busy"><span class="request-spinner" aria-hidden="true"></span>Kaydediliyor…</span>
			</button>
		</form>
	}
}

// --- desktop side-column panels -----------------------------------------
templ todayWeekMini(p TodayPage) {
	<section class="rounded-panel bg-card p-6">
		<p class="text-label font-semibold text-ink-3">Bu hafta</p>
		<p class="mt-1 cn leading-none">
			<span class="text-numeral-display font-semibold text-ink">{ strconv.Itoa(p.WeekDoneMin) }</span>
			<span class="text-numeral-unit text-ink-3">/ { strconv.Itoa(p.WeekPlannedMin) } dk</span>
		</p>
		if p.Week != nil {
			<div class="mt-4 grid grid-cols-7 items-end gap-1.5" style="height:64px">
				for _, b := range weekBars(p.Week) {
					if b.Rest {
						<span class="w-full rounded-pill bg-line" style="height:3px"></span>
					} else if b.IsToday {
						<span class="chart-rise w-full rounded-xs bg-z3-soft" { styleAttr("height:" + pct(b.HeightPct) + ";box-shadow:inset 0 0 0 2px var(--color-z3)")... }></span>
					} else {
						<span class={ "chart-rise w-full rounded-xs", barClass(b) } { styleAttr("height:" + pct(b.HeightPct))... }></span>
					}
				}
			</div>
			<div class="mt-1 grid grid-cols-7 gap-1.5 text-center text-label text-ink-3">
				for _, b := range weekBars(p.Week) {
					<span class={ templ.KV("font-semibold text-ink", b.IsToday) }>{ b.WeekdayShort }</span>
				}
			</div>
		}
		<p class="mt-3 text-meta text-ink-3">{ progressMeasure }</p>
	</section>
}

templ todayTomorrow(sv *plan.SessionView) {
	<section class="rounded-panel bg-card p-6">
		<p class="text-label font-semibold text-ink-3">Yarın</p>
		if sv != nil {
			<p class="mt-1 text-title-lg font-semibold text-ink">{ chapterRef(*sv) } { chapterTitle(*sv) }</p>
			<p class="text-body-small tnum text-ink-3">{ tomorrowLine(*sv) }</p>
		} else {
			<p class="mt-1 text-body-small text-ink-3">Dinlenme</p>
		}
	</section>
}

templ todayNote(notes []string) {
	<section class="rounded-panel bg-card p-6">
		<p class="text-label font-semibold text-ink-3">Not</p>
		if len(notes) > 0 {
			<p class="mt-1 text-body-small text-ink">{ notes[0] }</p>
		} else {
			<p class="mt-1 text-body-small text-ink-3">Bu hafta taşınan seans yok.</p>
		}
	</section>
}

// --- stat tiles (mobile) -------------------------------------------------
templ statTile(label string, value string, unit string) {
	<div class="rounded-panel bg-card p-3.5">
		<p class="text-label font-semibold text-ink-3">{ label }</p>
		<p class="mt-1 cn text-numeral-stat font-semibold leading-none text-ink">{ value }</p>
		<p class="text-label text-ink-3">{ unit }</p>
	</div>
}

templ statTileFrac(label string, done int, total int, unit string) {
	<div class="rounded-panel bg-card p-3.5">
		<p class="text-label font-semibold text-ink-3">{ label }</p>
		<p class="mt-1 cn text-numeral-stat font-semibold leading-none text-ink">
			{ strconv.Itoa(done) }<span class="text-numeral-unit text-ink-3">/ { strconv.Itoa(total) }</span>
		</p>
		<p class="text-label text-ink-3">{ unit }</p>
	</div>
}
