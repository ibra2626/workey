package views

import (
	"strconv"

	"github.com/ibra2626/workey/internal/plan"
)

// Sources is the Kaynaklar screen: the agent-extracted catalog with per-source
// and per-section reporting, and an in-place correction form per source. It
// follows DESIGN.md — soft tokens, Barlow, no gamification.
templ Sources(p SourcesPage) {
	@Layout(LayoutProps{Title: "Workey · Kaynaklar", Active: "kaynaklar", CSRF: p.CSRF}) {
		@SourcesMain(p)
	}
}

// SourcesMain swaps every card's figures and the feedback banner together, so a
// save refreshes the whole list.
templ SourcesMain(p SourcesPage) {
	<div id="kaynaklar-main">
		<div class="flex items-baseline justify-between px-1">
			<p class="text-title-lg font-semibold text-ink md:text-headline md:font-bold">Kaynaklar</p>
		</div>
		<p class="mt-2 px-1 text-body-small text-ink-2">Asistanın çıkardığı kaynakları gözden geçir ve düzelt. Kaynak, bölüm ve birim bilgilerini değiştirmek birim ilerlemesini korur.</p>
		if p.Feedback != "" {
			<div class="mt-3 rounded-panel bg-card p-4 text-body text-ink" role={ studyFeedbackRole(p.Invalid) } tabindex="-1">
				<p>{ p.Feedback }</p>
			</div>
		}
		if p.Catalog == nil || len(p.Catalog.Sources) == 0 {
			<div class="mt-5 rounded-panel bg-card p-5 md:p-8">
				<h2 class="text-title-lg font-semibold text-ink">Henüz kaynak yok.</h2>
				<p class="mt-2 text-body text-ink-2">Asistan kaynakları ekleyince burada listelenip düzeltilebilecek.</p>
			</div>
		} else {
			<div class="mt-5 space-y-3 md:space-y-5">
				for _, src := range p.Catalog.Sources {
					@sourceCard(p, src)
				}
			</div>
		}
	</div>
}

// sourceCard is one source: its report figures and its whole-source edit form.
templ sourceCard(p SourcesPage, src plan.SourceView) {
	<section id={ "kaynak-" + src.Key } class="rounded-panel bg-card p-5 md:p-8">
		<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
			<h2 class="text-title-lg font-semibold text-ink">{ src.Name }</h2>
			<p class="text-meta text-ink-3">{ src.Key } · { kindLabel(src.Kind) } · { unitLabel(src.LocationUnit) }</p>
		</div>
		@progressFigures(p.sourceTotals(src.ID), src.Kind)
		<form class="mt-5 space-y-5" { sourceFormAttrs(src.Key)... }>
			<input type="hidden" name="_csrf" value={ p.CSRF }/>
			<input type="hidden" name="ordinal" value={ strconv.Itoa(src.Ordinal) }/>
			<input type="hidden" name="section_ordinals" value={ sectionOrdinalsCSV(src) }/>
			<div class="grid gap-3 md:grid-cols-3">
				@textField("name", "Ad", src.Name)
				@selectField("kind", "Tür", sourceKindOptions(), src.Kind, kindLabel)
				@selectField("location_unit", "Konum birimi", locationUnitOptions(), src.LocationUnit, unitLabel)
			</div>
			for _, sec := range src.Sections {
				@sectionFields(p, src, sec)
			}
			<button type="submit" class="action-button flex h-11 items-center justify-center gap-2 rounded-pill bg-ink px-6 text-body font-semibold text-card hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:3px]">
				@actionLabel("Kaydet", "Kaydediliyor…")
			</button>
		</form>
	</section>
}

// sectionFields is one section's editable fields, its report, and its units. The
// hidden unit-ordinal list preserves each unit's ordinal across the re-write.
templ sectionFields(p SourcesPage, src plan.SourceView, sec plan.SectionView) {
	<fieldset class="rounded-block border border-line p-4">
		<input type="hidden" name={ secFieldName(sec.Ordinal, "unit_ordinals") } value={ unitOrdinalsCSV(sec) }/>
		<legend class="px-1 text-label font-semibold text-ink-3">Bölüm { strconv.Itoa(sec.Ordinal) }</legend>
		<div class="grid gap-3 md:grid-cols-3">
			@textField(secFieldName(sec.Ordinal, "name"), "Bölüm adı", sec.Name)
			@numberField(secFieldName(sec.Ordinal, "loc_from"), "Konum başlangıcı", optIntValue(sec.LocFrom))
			@numberField(secFieldName(sec.Ordinal, "loc_to"), "Konum bitişi", optIntValue(sec.LocTo))
		</div>
		@progressFigures(p.sectionTotals(sec.ID), src.Kind)
		if len(sec.Units) > 0 {
			<div class="mt-3 space-y-2">
				for _, u := range sec.Units {
					@unitFields(sec, u)
				}
			</div>
		}
	</fieldset>
}

// unitFields is one study unit's editable row: label, number, and location range.
templ unitFields(sec plan.SectionView, u plan.UnitView) {
	<div class="grid gap-2 md:grid-cols-4">
		@textField(unitFieldName(sec.Ordinal, u.Ordinal, "label"), "Birim etiketi", u.Label)
		@numberField(unitFieldName(sec.Ordinal, u.Ordinal, "number"), "No", optIntValue(u.Number))
		@numberField(unitFieldName(sec.Ordinal, u.Ordinal, "loc_from"), "Konum başlangıcı", optIntValue(u.LocFrom))
		@numberField(unitFieldName(sec.Ordinal, u.Ordinal, "loc_to"), "Konum bitişi", optIntValue(u.LocTo))
	</div>
}

// progressFigures renders the done-count and, for non-video sources, the D/Y/B
// sums as calm figures (no badges or streaks). A video source shows done only.
templ progressFigures(t plan.ProgressTotals, kind string) {
	<dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-body-small">
		@reportFigure("Tamamlanan", strconv.Itoa(t.DoneCount))
		if !isVideoKind(kind) {
			@reportFigure("Doğru", strconv.Itoa(t.Correct))
			@reportFigure("Yanlış", strconv.Itoa(t.Wrong))
			@reportFigure("Boş", strconv.Itoa(t.Blank))
		}
	</dl>
}

templ reportFigure(label string, value string) {
	<div class="flex items-baseline gap-1.5">
		<dt class="text-ink-3">{ label }</dt>
		<dd class="tnum font-semibold text-ink">{ value }</dd>
	</div>
}

// textField and numberField are the shared labelled inputs; the 44px height
// keeps touch targets at the DESIGN.md minimum.
templ textField(name string, label string, value string) {
	<label class="block text-body-small text-ink-2">
		{ label }
		<input type="text" name={ name } value={ value } class="mt-1 h-11 w-full rounded-nav border border-line bg-ground px-3 text-body text-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:1px]"/>
	</label>
}

templ numberField(name string, label string, value string) {
	<label class="block text-body-small text-ink-2">
		{ label }
		<input type="text" inputmode="numeric" name={ name } value={ value } class="mt-1 h-11 w-full rounded-nav border border-line bg-ground px-3 text-body tnum text-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:1px]"/>
	</label>
}

templ selectField(name string, label string, options []string, selected string, labeler func(string) string) {
	<label class="block text-body-small text-ink-2">
		{ label }
		<select name={ name } class="mt-1 h-11 w-full rounded-nav border border-line bg-ground px-3 text-body text-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:1px]">
			for _, opt := range options {
				<option value={ opt } selected?={ opt == selected }>{ labeler(opt) }</option>
			}
		</select>
	</label>
}
