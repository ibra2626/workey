package views

import "strconv"

// LayoutProps carries the shell's per-page inputs: the document title, the
// active nav key (including usage pages), the per-session CSRF token,
// and the exam countdown shown in the desktop rail's foot.
type LayoutProps struct {
	Title      string
	Active     string
	CSRF       string
	DaysToExam int
	HasExam    bool
}

// Layout is the base HTML shell: Turkish document, embedded CSS and htmx, the
// desktop rail and the mobile bottom tab bar, and a slot for page content. The
// CSRF token is attached to <body> via hx-headers so every htmx request carries
// it.
templ Layout(p LayoutProps) {
	<!DOCTYPE html>
	<html lang="tr">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			<link rel="stylesheet" href={ asset("/static/app.css") }/>
			<script defer src={ asset("/static/htmx.min.js") }></script>
		</head>
		<body class="min-h-screen" { hxHeaders(p.CSRF)... }>
			@iconSprite()
			<div class="md:flex md:min-h-screen">
				@rail(p)
				<main class="min-w-0 flex-1 px-3 pt-6 pb-[88px] md:px-8 md:py-8">
					{ children... }
				</main>
			</div>
			@tabBar(p.Active)
		</body>
	</html>
}

// iconSprite holds the stroked line icons (1.8 stroke, round caps) referenced
// by <use> throughout the layout. Kept off-screen and hidden from the a11y tree.
templ iconSprite() {
	<svg width="0" height="0" class="absolute" aria-hidden="true">
		<symbol id="i-today" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></symbol>
		<symbol id="i-week" viewBox="0 0 24 24"><path d="M5 20V12M10 20V8M15 20v-6M20 20V5"></path></symbol>
		<symbol id="i-prog" viewBox="0 0 24 24"><path d="M3 18c3-1 4-6 7-6s4 3 7 2 3-6 4-8"></path></symbol>
		<symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></symbol>
		<symbol id="i-guide" viewBox="0 0 24 24"><path d="M4 4h6l2 2 2-2h6v15h-6l-2 2-2-2H4zM12 6v15"></path></symbol>
	</svg>
}

// icon renders a sprite symbol. sizeClass sets the width/height utilities.
templ icon(id string, sizeClass string) {
	<svg
		class={ "fill-none stroke-current [stroke-width:1.8] [stroke-linecap:round] [stroke-linejoin:round]", sizeClass }
		aria-hidden="true"
	>
		<use href={ "#" + id }></use>
	</svg>
}

// rail is the desktop-only left navigation (232px, Card White, right hairline).
// Its foot carries the days-to-exam figure (DESIGN.md desktop rail).
templ rail(p LayoutProps) {
	<nav class="hidden md:flex md:w-[232px] md:shrink-0 md:flex-col gap-1 bg-card border-r border-line px-5 pt-7 pb-7">
		<p class="cn mb-7 px-3 text-wordmark font-semibold text-ink">Workey</p>
		for _, it := range append(append([]navItem(nil), navItems...), usageNavItems...) {
			<a
				href={ templ.SafeURL(it.Href) }
				class="flex items-center gap-3 rounded-nav px-3 py-[10px] text-body text-ink-3 no-underline transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:2px] aria-[current=page]:bg-ground aria-[current=page]:font-semibold aria-[current=page]:text-ink"
				{ ariaCurrent(p.Active == it.Key)... }
			>
				@icon(it.Icon, "w-5 h-5")
				{ it.Label }
			</a>
		}
		if p.HasExam && p.DaysToExam > 0 {
			<div class="mt-auto px-3">
				<p class="text-label font-semibold text-ink-3">Sınava</p>
				<p class="cn leading-none text-numeral-rail font-semibold text-ink">
					{ strconv.Itoa(p.DaysToExam) } <span class="text-numeral-unit text-ink-3">gün</span>
				</p>
			</div>
		}
	</nav>
}

// tabBar is the mobile-only bottom tab bar (68px, Card White, top hairline).
templ tabBar(active string) {
	<nav class="fixed inset-x-0 bottom-0 z-10 grid h-[68px] grid-cols-4 border-t border-line bg-card md:hidden">
		for _, it := range mobileNavItems() {
			<a
				href={ templ.SafeURL(it.Href) }
				class="flex flex-col items-center justify-center gap-1 rounded-nav text-label text-ink-3 no-underline transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:-2px] aria-[current=page]:font-semibold aria-[current=page]:text-ink"
				{ ariaCurrent(mobileActive(active) == it.Key)... }
			>
				@icon(it.Icon, "w-[22px] h-[22px]")
				{ it.Label }
			</a>
		}
	</nav>
}
