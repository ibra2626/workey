package views

// Login is the Giriş screen: a single white panel on the Trail Ground, the
// Workey wordmark, one password field and the dark ink pill as the only action.
// It is self-contained (no nav rail or tab bar) and carries no shadows, matching
// DESIGN.md. errMsg is a plain Turkish sentence shown when login failed; empty
// on the first view. Mobile-first, centered at every width.
templ Login(errMsg string) {
	<!DOCTYPE html>
	<html lang="tr">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Workey · Giriş</title>
			@fontPreloads(false)
			<link rel="stylesheet" href={ asset("/static/app.css") }/>
			<script defer src={ asset("/static/ui.js") }></script>
		</head>
		<body class="min-h-screen">
			@requestFeedback()
			<main class="flex min-h-screen items-center justify-center px-5 py-10">
				<div class="w-full max-w-[400px] rounded-panel bg-card p-7 md:p-8">
					@brandLogo("h-auto w-[200px]")
					<h1 class="mt-5 text-title-lg font-semibold text-ink">Giriş</h1>
					<form method="post" action="/giris" class="mt-5">
						<label for="parola" class="block text-label font-semibold text-ink-3">Parola</label>
						<input
							id="parola"
							name="parola"
							type="password"
							autocomplete="current-password"
							autofocus
							required
							class="mt-2 block w-full rounded-nav border border-line bg-card px-3 py-[10px] text-body text-ink focus:border-ink focus:outline-2 focus:outline-ink focus:[outline-offset:2px]"
						/>
						if errMsg != "" {
							<p class="mt-3 text-body-small text-ink-2">{ errMsg }</p>
						}
						<button
							type="submit"
							class="action-button primary-action mt-5 flex h-[54px] w-full items-center justify-center rounded-pill bg-ink px-10 text-title font-semibold text-card hover:bg-ink-hover focus-visible:outline-2 focus-visible:outline-ink focus-visible:[outline-offset:3px]"
						>
							@actionLabel("Giriş yap", "Giriş yapılıyor…")
						</button>
					</form>
				</div>
			</main>
		</body>
	</html>
}
