package views

import (
	"strconv"

	"github.com/ibra2626/workey/internal/plan"
)

// Progress is the İlerleme screen: honest progress against the exam date — plan
// position, totals, the 38-week strip and the topic-group tracks. It matches the
// İlerleme artboards minus the removed seviye-testi and deneme panels
// (DECISIONS); the layout rebalances to a single column so no hole is left.
templ Progress(p ProgressPage) {
	@Layout(LayoutProps{Title: "Workey · İlerleme", Active: "ilerleme", CSRF: p.CSRF, DaysToExam: p.DaysToExam, HasExam: p.HasExam}) {
		<div class="flex items-baseline justify-between px-1">
			<h1 class="text-title-lg font-semibold text-ink md:hidden">İlerleme</h1>
			<h1 class="hidden text-headline font-bold text-ink md:block">İlerleme</h1>
			if p.HasExam || p.Progress.PlannedMin > 0 {
				<p class="text-meta tnum text-ink-3 md:text-body-small">
					<span class="md:hidden">
						if p.HasExam && p.DaysToExam > 0 {
							{ strconv.Itoa(p.DaysToExam) } gün · { p.Progress.ExamDate }
						} else {
							{ strconv.Itoa(p.Progress.SessionsDone) } / { strconv.Itoa(p.Progress.SessionsPlanned) } seans
						}
					</span>
					<span class="hidden md:inline">
						{ strconv.Itoa(p.Progress.SessionsDone) } / { strconv.Itoa(p.Progress.SessionsPlanned) } seans · { p.Progress.DoneHours } / { p.Progress.PlannedHours } saat
					</span>
				</p>
			}
		</div>
		if !p.Progress.HasPlan {
			<section class="mt-5 rounded-panel bg-card p-5 md:p-7">
				<p class="text-title-lg font-semibold text-ink">Plan henüz yazılmadı.</p>
				<p class="mt-2 text-body text-ink-2">Asistan planı yazınca ilerleme burada 38 hafta üzerinden gösterilecek.</p>
			</section>
		} else {
			<!-- İvme: the honest streak meter (gamification, no-blame framing). -->
			@momentumMeter(p.Progress)
			<!-- Plan position and the 38-week strip. -->
			<section class="mt-3 rounded-panel bg-card p-5 md:mt-5 md:p-7">
				<div class="flex items-end justify-between">
					<div>
						<p class="text-label font-semibold text-ink-3">38 haftalık plan</p>
						<p class="mt-1 cn leading-none">
							<span class="text-numeral-rail font-semibold text-ink md:text-numeral-display">{ strconv.Itoa(p.Progress.WeekNumber) }</span>
							<span class="text-numeral-unit text-ink-3">/ { strconv.Itoa(p.Progress.WeeksTotal) } hafta</span>
						</p>
					</div>
					<!-- Mobile totals / desktop legend. -->
					<p class="text-right text-meta tnum text-ink-3 md:hidden">
						{ p.Progress.DoneHours } / { p.Progress.PlannedHours } sa<br/>
						{ strconv.Itoa(p.Progress.SessionsDone) } / { strconv.Itoa(p.Progress.SessionsPlanned) } seans
					</p>
					<div class="hidden gap-5 text-meta text-ink-3 md:flex">
						@legendSwatch("var(--color-ink)", "Yapılan")
						@legendSwatch("var(--gradient-momentum)", "Gidilen yol")
						@legendSwatch("var(--color-accent)", "Kilometre taşı")
					</div>
				</div>
				<!-- Zirveye giden yol: the 38-week plan as a climb to the exam summit. -->
				@summitRoadSVG(p.Progress)
				<div class="mt-1.5 flex justify-between text-label tnum text-ink-3">
					<span>{ phaseRangeLabel(p.Progress) }</span>
					<span>H{ strconv.Itoa(p.Progress.WeeksTotal) }
						if p.Progress.ExamDate != "" {
							· { p.Progress.ExamDate }
						}
					</span>
				</div>
			</section>
			<!-- Topic groups. -->
			<p class="mt-3 px-1 text-meta text-ink-3">{ progressMeasure } { progressCounting }</p>
			<section class="mt-3 rounded-panel bg-card p-5 md:mt-5 md:p-7">
				<p class="text-label font-semibold text-ink-3">Konu grupları · soru ağırlığı ve tamamlanan</p>
				<ul class="mt-4 space-y-3 md:space-y-4">
					for _, gp := range p.Progress.Groups {
						@groupRow(gp)
					}
				</ul>
			</section>
			<!-- Unit-level progress (D/Y/B), independent of session completion. -->
			if p.Units.HasUnits() {
				<section class="mt-3 rounded-panel bg-card p-5 md:mt-5 md:p-7">
					<div class="flex items-baseline justify-between">
						<p class="text-label font-semibold text-ink-3">Birim ilerlemesi</p>
						<p class="cn text-numeral-inline font-semibold leading-none">
							<span class={ percentClass(p.Units.DoneCount) }>{ strconv.Itoa(p.Units.DoneCount) }</span><span class="text-numeral-unit text-ink-3">/ { strconv.Itoa(p.Units.TotalUnits) } birim</span>
						</p>
					</div>
					<div class="mt-3 h-[6px] overflow-hidden rounded-bar bg-line">
						if p.Units.DonePct() > 0 {
							<span class="chart-grow block h-full rounded-bar bg-ink" { styleAttr("width:" + pct(p.Units.DonePct()))... }></span>
						}
					</div>
					if p.Units.Answered() > 0 {
						<dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-body-small">
							@reportFigure("Doğru", strconv.Itoa(p.Units.Correct))
							@reportFigure("Yanlış", strconv.Itoa(p.Units.Wrong))
							@reportFigure("Boş", strconv.Itoa(p.Units.Blank))
							@reportFigure("Çözülen", strconv.Itoa(p.Units.Answered()))
						</dl>
					}
					<p class="mt-3 text-meta text-ink-3">Birim ilerlemesi kaydedilen birimlerden sayılır; seans tamamlamadan bağımsızdır. Doğru/yanlış/boş yalnızca kullanıcının girdiği değerlerdir.</p>
				</section>
			}
		}
	}
}

// groupRow renders one topic group's completion: a progress track with the done
// share in ink, the DGS question weight, and the condensed percentage (Lichen
// Ink at zero).
templ groupRow(gp plan.GroupProgress) {
	<!-- Mobile. -->
	<li class="md:hidden">
		<div class="flex items-baseline justify-between gap-3">
			<span class="flex min-w-0 items-center gap-1.5 text-body font-semibold text-ink">
				{ gp.Name }
				if gp.Percent >= 100 {
					@icon("i-check", "mastery-check")
				}
			</span>
			<span class={ "cn text-numeral-inline font-semibold", percentClass(gp.Percent) }>%{ strconv.Itoa(gp.Percent) }</span>
		</div>
		<div class="mt-1 flex items-center gap-2">
			<div class="h-[6px] flex-1 overflow-hidden rounded-bar bg-line">
				if gp.Percent > 0 {
					<span class={ "chart-grow block h-full rounded-bar bg-ink", templ.KV("track-mastered", gp.Percent >= 100) } { styleAttr("width:" + pct(gp.Percent))... }></span>
				}
			</div>
			<span class="w-[64px] text-right text-label tnum text-ink-3">{ dgsLabel(gp) }</span>
		</div>
	</li>
	<!-- Desktop. -->
	<li class="hidden grid-cols-[200px_1fr_70px_48px] items-center gap-4 md:grid">
		<span class="flex items-center gap-1.5 text-body font-semibold text-ink">
			{ gp.Name }
			if gp.Percent >= 100 {
				@icon("i-check", "mastery-check")
			}
		</span>
		<div class="h-[8px] overflow-hidden rounded-bar bg-line">
			if gp.Percent > 0 {
				<span class={ "chart-grow block h-full rounded-bar bg-ink", templ.KV("track-mastered", gp.Percent >= 100) } { styleAttr("width:" + pct(gp.Percent))... }></span>
			}
		</div>
		<span class="text-right text-meta tnum text-ink-3">{ dgsLabel(gp) }</span>
		<span class={ "text-right cn text-numeral-unit font-semibold", percentClass(gp.Percent) }>%{ strconv.Itoa(gp.Percent) }</span>
	</li>
}

// legendSwatch is one coloured square with its label, for the road legend.
templ legendSwatch(fill string, label string) {
	<span class="flex items-center gap-1.5">
		<span class="h-3 w-3 rounded-xs" { styleAttr("background:" + fill)... }></span>
		{ label }
	</span>
}

// momentumMeter is the İvme panel: the consecutive-study-day streak as a warm
// flame that lights once the run is alive. Every figure is honest (computeStreak
// over completed sessions); a broken run is framed as an invitation, never a
// scolding, and a rest day keeps the run. Decorative to the a11y tree beyond the
// panel label; the status line carries the meaning.
templ momentumMeter(v *plan.ProgressView) {
	<section class={ "momentum rounded-panel bg-card p-5 md:p-6", templ.KV("is-lit", v.Streak > 0) } aria-label="İvme">
		<svg class="momentum-flame" viewBox="0 0 24 28" aria-hidden="true">
			<defs>
				<linearGradient id="flame-grad" x1="0" y1="1" x2="0" y2="0">
					<stop offset="0" stop-color="var(--color-accent-2)"></stop>
					<stop offset="1" stop-color="var(--color-accent)"></stop>
				</linearGradient>
			</defs>
			<path d="M12 1.5c2.2 5 7 6.2 7 12.8A7 7 0 0 1 5 14.3c0-2 .8-3.7 2.1-5.1.1 2 1.3 3.1 2.6 3.4C8.5 8 9.7 4.4 12 1.5z"></path>
		</svg>
		<div class="momentum-body">
			<p class="momentum-label">İvme</p>
			if v.Streak > 0 {
				<p class="momentum-hero cn leading-none">
					<span class="momentum-num">{ strconv.Itoa(v.Streak) }</span>
					<span class="momentum-unit">gün üst üste</span>
				</p>
			}
			<p class="momentum-status">{ streakStatus(v) }</p>
		</div>
	</section>
}

// summitRoadSVG draws the İlerleme "zirveye giden yol": the 38 plan weeks as a
// climb to the exam summit. The faint mountain and the climbing ground line are
// the plan; the momentum ribbon is the distance travelled in time (up to the
// current week); the ink studs are each week's real done share; the accent dots
// are phase milestones; the summit glows with the exam date; the current week
// pulses. Every figure is honest Strip data. Decorative to the a11y tree beyond
// the one summary label — the numbers above and the tracks below carry the data.
templ summitRoadSVG(v *plan.ProgressView) {
	if r, ok := buildSummitRoad(v); ok {
		<div class="mt-4 md:mt-5">
			<svg
				class="summit-road"
				viewBox={ "0 0 " + strconv.Itoa(r.W) + " " + strconv.Itoa(r.H) }
				preserveAspectRatio="xMidYMid meet"
				role="img"
				aria-label={ r.Aria }
			>
				<defs>
					<linearGradient id="road-momentum" x1="0" y1="1" x2="1" y2="0">
						<stop offset="0" stop-color="var(--color-accent)"></stop>
						<stop offset="1" stop-color="var(--color-accent-2)"></stop>
					</linearGradient>
				</defs>
				<polygon class="road-base" points={ r.Base }></polygon>
				if r.HasRibbon {
					<polygon class="road-ribbon" points={ r.Ribbon }></polygon>
				}
				<polyline class="road-line" points={ r.Ground }></polyline>
				for _, s := range r.Studs {
					<rect class="road-stud" x={ strconv.Itoa(s.X - 4) } y={ strconv.Itoa(s.Y) } width="8" height={ strconv.Itoa(s.H) } rx="2"></rect>
				}
				for _, m := range r.Milestones {
					<circle class="road-mile" cx={ strconv.Itoa(m.X) } cy={ strconv.Itoa(m.Y) } r="4.5"></circle>
				}
				<circle class="road-summit-glow" cx={ strconv.Itoa(r.Summit.X) } cy={ strconv.Itoa(r.Summit.Y) } r="15"></circle>
				<circle class="road-summit-dot" cx={ strconv.Itoa(r.Summit.X) } cy={ strconv.Itoa(r.Summit.Y) } r="6"></circle>
				if r.ExamLabel != "" {
					<text class="road-summit-label" x={ strconv.Itoa(r.Summit.X) } y={ strconv.Itoa(r.Summit.Y - 20) } text-anchor="end">{ r.ExamLabel }</text>
				}
				if r.Marker != nil {
					<circle class="road-now-halo" cx={ strconv.Itoa(r.Marker.X) } cy={ strconv.Itoa(r.Marker.Y) } r="9"></circle>
					<circle class="road-now" cx={ strconv.Itoa(r.Marker.X) } cy={ strconv.Itoa(r.Marker.Y) } r="5.5"></circle>
				}
			</svg>
		</div>
	}
}
